# Copy this file to ".env" and fill in your values

# Which LLM to use: "gemini" or "groq" (both FREE, no billing needed)
# "anthropic" or "openai" also supported if you have paid keys
LLM_PROVIDER=gemini

# --- FREE options (no credit card required) ---
# Gemini key: https://aistudio.google.com/apikey
GEMINI_API_KEY=your_key_here
# Groq key: https://console.groq.com/keys
GROQ_API_KEY=your_key_here

# --- PAID options (require billing) ---
ANTHROPIC_API_KEY=your_key_here
OPENAI_API_KEY=your_key_here

# Wake word Darling responds to
WAKE_WORD=darling

# Voice for text-to-speech (edge-tts). Try: en-US-GuyNeural, en-US-JennyNeural, en-IN-PrabhatNeural
TTS_VOICE=en-US-GuyNeural
